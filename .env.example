# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=pega-aqui-tu-clave
# Modelo de lenguaje. Plan gratuito: gemini-3.5-flash-lite (~500 solicitudes/día).
# gemini-3.8-flash es más capaz pero solo ~20 solicitudes/día en el plan gratuito.
# gemini-2.5-flash ya no está disponible para usuarios nuevos.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# Modelo de embeddings: debe ser el MISMO en la ingesta y en la consulta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Gemini 3.x: dejar vacío para usar la temperatura del modelo (recomendado por Google).
LLM_TEMPERATURE=
# Razonamiento interno: minimal | low | medium | high (vacío = por defecto del modelo)
LLM_THINKING_LEVEL=low
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_WINDOW=131072
LLM_TIMEOUT_SECONDS=30

# --- Rutas ---
CORPUS_DIR=data/corpus
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=reglamentos

# --- Fragmentación y recuperación ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=3
SIMILARITY_THRESHOLD=0.60

# --- API ---
ADMIN_API_KEY=cambia-esta-clave-de-administrador
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# true: logs en JSON (evidencia); false: texto legible
LOG_JSON=true
