data/corpus/*.pdf

# --- Reportes generados (se conservan solo los que se suban a propósito) ---
eval/reports/*.tmp
eval/reports/fragmentos.jsonl

# --- Editores y sistema ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
