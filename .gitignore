# --- Secretos ---
.env
.env.*
!.env.example

# --- Entornos virtuales ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Herramientas ---
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Datos (índice y corpus no se versionan) ---
data/chroma/*
